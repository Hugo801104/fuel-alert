# Copiez ce fichier vers ".env" et renseignez vos propres valeurs.
# Ne commitez JAMAIS le fichier ".env" réel (déjà exclu via .gitignore).

# --- Localisation ---
LATITUDE=48.8566
LONGITUDE=2.3522
RADIUS_KM=5

# --- Carburant ---
# Valeurs possibles: E10, SP95, SP98, Gazole, E85, GPLc
FUEL_TYPE=Gazole

# --- Notifications (Apprise) ---
# Une ou plusieurs URLs séparées par des virgules. Exemples:
#   Telegram : tgram://<bot_token>/<chat_id>
#   Discord  : discord://<webhook_id>/<webhook_token>
#   Slack    : slack://<token_a>/<token_b>/<token_c>
#   E-mail   : mailtos://<user>:<password>@<smtp_host>?to=<destination_email>
NOTIFICATION_URLS=tgram://123456:ABCDEF/987654321

# --- Divers ---
DRY_RUN=false
LOG_LEVEL=INFO
